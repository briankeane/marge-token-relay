# Public URL of this deployed app (no trailing slash)
BASE_URL=http://localhost:3000

# Storage backend: "redis" (prod) or "memory" (local/tests)
KV_BACKEND=redis
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 authorization endpoint
GOOGLE_AUTH_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth

# Session/entry TTL in seconds (~10 minutes)
SESSION_TTL_SECONDS=600

# Server port (Render provides PORT automatically)
PORT=3000

# Postgres connection string (optional; relay boots DB-less when unset).
# Used by Sequelize at runtime and by `npm run migrate` (sequelize-cli).
# DATABASE_URL=postgres://postgres:pass@localhost:5432/margedev

# Secret used to verify HS256 JWTs on /v1 protected routes.
# In production this is read from the Render `production` env group; an unset
# secret safely yields 401. Set a local value here only if you need it.
# JWT_SECRET=
